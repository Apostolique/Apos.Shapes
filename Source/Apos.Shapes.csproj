<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>

    <PackageId>Apos.Shapes</PackageId>
    <Description>Shape rendering in MonoGame.</Description>
    <PackageTags>gamedev;monogame;shapes</PackageTags>

    <Authors>Jean-David Moisan</Authors>
    <Copyright>Copyright 2026</Copyright>

    <RepositoryUrl>https://github.com/Apostolique/Apos.Shapes</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Apostolique/Apos.Shapes</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>

    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Nullable>enable</Nullable>
    <!-- The glyph baker reads outlines through stb_truetype, whose interface is pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" PrivateAssets="All" Version="3.8.2.1105" />
    <PackageReference Include="MonoGame.Extended" Version="5.3.1" />
    <!-- Reads the glyph outlines the shader solves. -->
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Images/Icon.png" Pack="true" PackagePath="" />
    <None Include="../LICENSE" Pack="true" PackagePath="" />
    <None Include="../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" />
    <None Include="$(BaseIntermediateOutputPath)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <AposShaderDir>$(BaseIntermediateOutputPath)shaders/</AposShaderDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(AposShaderDir)apos-shapes.ogl.mgfx.br" LogicalName="Apos.Shapes.apos-shapes.ogl.mgfx.br" Visible="false" />
    <EmbeddedResource Include="$(AposShaderDir)apos-shapes.dx11.mgfx.br" LogicalName="Apos.Shapes.apos-shapes.dx11.mgfx.br" Visible="false" />
    <EmbeddedResource Include="$(AposShaderDir)apos-shapes.vk.mgfx.br" LogicalName="Apos.Shapes.apos-shapes.vk.mgfx.br" Visible="false" />
    <EmbeddedResource Include="$(AposShaderDir)apos-shapes.dx12.mgfx.br" LogicalName="Apos.Shapes.apos-shapes.dx12.mgfx.br" Visible="false" />
  </ItemGroup>

  <Target Name="CompileAposShader" BeforeTargets="BeforeBuild"
          Inputs="Content/apos-shapes.fx;../Tools/ShaderPack/Program.cs;$(MSBuildProjectFullPath);../.config/dotnet-tools.json"
          Outputs="$(AposShaderDir)apos-shapes.ogl.mgfx.br;$(AposShaderDir)apos-shapes.dx11.mgfx.br;$(AposShaderDir)apos-shapes.vk.mgfx.br;$(AposShaderDir)apos-shapes.dx12.mgfx.br">
    <MakeDir Directories="$(AposShaderDir)" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- Roll forward so the net8.0 tool still runs when only a newer runtime is installed, like in CI. -->
    <Exec Command="dotnet tool run ShadowDuskCLI &quot;Content/apos-shapes.fx&quot; &quot;$(AposShaderDir)apos-shapes.ogl.mgfx&quot; /Profile:OpenGL" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
    <Exec Command="dotnet tool run ShadowDuskCLI &quot;Content/apos-shapes.fx&quot; &quot;$(AposShaderDir)apos-shapes.dx11.mgfx&quot; /Profile:DirectX_11" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
    <Exec Command="dotnet tool run ShadowDuskCLI &quot;Content/apos-shapes.fx&quot; &quot;$(AposShaderDir)apos-shapes.vk.mgfx&quot; /Profile:Vulkan" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
    <Exec Command="dotnet tool run ShadowDuskCLI &quot;Content/apos-shapes.fx&quot; &quot;$(AposShaderDir)apos-shapes.dx12.mgfx&quot; /Profile:DirectX_12" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
    <!-- See Tools/ShaderPack for why the two packages compress differently. -->
    <Exec Command="dotnet run --project ../Tools/ShaderPack/ShaderPack.csproj -c Release -- brotli &quot;$(AposShaderDir)apos-shapes.ogl.mgfx&quot; &quot;$(AposShaderDir)apos-shapes.dx11.mgfx&quot; &quot;$(AposShaderDir)apos-shapes.vk.mgfx&quot; &quot;$(AposShaderDir)apos-shapes.dx12.mgfx&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>

  <!-- The packed copy of the readme needs absolute image URLs: nuget.org only renders
       images from trusted hosts and can't resolve repo-relative paths. A release run links to
       its own tag, so later image changes don't reach older versions. -->
  <Target Name="PrepareNuGetReadme" BeforeTargets="GenerateNuspec">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <PropertyGroup>
      <_NuGetReadmeRef>main</_NuGetReadmeRef>
      <_NuGetReadmeRef Condition="'$(GITHUB_ACTIONS)' == 'true' And '$(GITHUB_REF_TYPE)' == 'tag'">$(GITHUB_REF_NAME)</_NuGetReadmeRef>
      <!-- '%' and ';' are MSBuild-escaped so WriteLinesToFile keeps them literal. -->
      <_NuGetReadme>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../README.md').Replace('](./Images/', '](https://raw.githubusercontent.com/Apostolique/Apos.Shapes/$(_NuGetReadmeRef)/Images/').Replace('%', '%25').Replace(';', '%3B'))</_NuGetReadme>
    </PropertyGroup>
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)README.md" Lines="$(_NuGetReadme)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <SourceRoot Include="$(MSBuildThisFileDirectory)/" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
