<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>

    <PackageId>Apos.Shapes.KNI</PackageId>
    <Description>Shape rendering in KNI.</Description>
    <PackageTags>gamedev;kni;shapes</PackageTags>

    <Authors>Jean-David Moisan</Authors>
    <Copyright>Copyright 2026</Copyright>

    <RepositoryUrl>https://github.com/Apostolique/Apos.Shapes</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Apostolique/Apos.Shapes</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>

    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);KNI</DefineConstants>
    <!-- The glyph baker reads outlines through stb_truetype, whose interface is pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
    <PackageReference Include="KNI.Extended" Version="5.3.1" />
    <!-- Reads the glyph outlines the shader solves. -->
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests check what a document bakes into, which needs no graphics device. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Apos.Shapes.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="../Images/Icon.png" Pack="true" PackagePath="" />
    <None Include="../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="" />
    <None Include="$(BaseIntermediateOutputPath)README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup>
    <AposShaderDir>$(BaseIntermediateOutputPath)shaders/</AposShaderDir>
  </PropertyGroup>

  <ItemGroup>
    <AposShaderPack Include="knifx;kni.dx11" />
    <EmbeddedResource Include="@(AposShaderPack->'$(AposShaderDir)apos-shapes.%(Identity).pack')" LogicalName="Apos.Shapes.%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <Target Name="CompileAposShader" BeforeTargets="BeforeBuild"
          Inputs="Content/apos-shapes.fx;../Tools/ShaderPack/Program.cs;$(MSBuildProjectFullPath);../.config/dotnet-tools.json"
          Outputs="@(AposShaderPack->'$(AposShaderDir)apos-shapes.%(Identity).pack')">
    <MakeDir Directories="$(AposShaderDir)" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- ShaderPack builds every version of the shader for a backend and packs them; see there.
         The GL shader models are spelled out: ShadowDusk reads 3.0 for the macro, and KNI's GL
         backends only take 3.0 shaders on the HiDef profile. -->
    <PropertyGroup>
      <_AposShaderPack>dotnet run --project ../Tools/ShaderPack/ShaderPack.csproj -c Release -- build Content/apos-shapes.fx</_AposShaderPack>
    </PropertyGroup>
    <Exec Command="$(_AposShaderPack) &quot;$(AposShaderDir)apos-shapes.knifx.pack&quot; gl lz vs_3_0 ps_3_0 --target-runtime kni-knifx" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
    <Exec Command="$(_AposShaderPack) &quot;$(AposShaderDir)apos-shapes.kni.dx11.pack&quot; bytecode lz VS_SHADERMODEL PS_SHADERMODEL /Profile:DirectX_11" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>

  <!-- The packed copy of the readme needs absolute image URLs: nuget.org only renders
       images from trusted hosts and can't resolve repo-relative paths. A release run links to
       its own tag, so later image changes don't reach older versions. -->
  <Target Name="PrepareNuGetReadme" BeforeTargets="GenerateNuspec">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <PropertyGroup>
      <_NuGetReadmeRef>main</_NuGetReadmeRef>
      <_NuGetReadmeRef Condition="'$(GITHUB_ACTIONS)' == 'true' And '$(GITHUB_REF_TYPE)' == 'tag'">$(GITHUB_REF_NAME)</_NuGetReadmeRef>
      <!-- '%' and ';' are MSBuild-escaped so WriteLinesToFile keeps them literal. -->
      <_NuGetReadme>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../README.md').Replace('](./Images/', '](https://raw.githubusercontent.com/Apostolique/Apos.Shapes/$(_NuGetReadmeRef)/Images/').Replace('%', '%25').Replace(';', '%3B'))</_NuGetReadme>
    </PropertyGroup>
    <WriteLinesToFile File="$(BaseIntermediateOutputPath)README.md" Lines="$(_NuGetReadme)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <SourceRoot Include="$(MSBuildThisFileDirectory)/" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
